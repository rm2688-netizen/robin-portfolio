		<footer class="site-footer">
			<p>© 2026 made with ❤ by Robin Miranda</p>
			<div>
				<a href="#top">Back to top</a>
			</div>
		</footer>

		<script>
			const dialog = document.querySelector("#credential-dialog");
			const title = document.querySelector("#credential-title");
			const meta = document.querySelector("#credential-meta");
			const mark = document.querySelector("#credential-mark");
			const focus = document.querySelector("#credential-focus");
			const detail = document.querySelector("#credential-detail");
			const requestLink = document.querySelector("[data-request-permission]");
			const closeButton = document.querySelector("[data-close-dialog]");
			const themeToggle = document.querySelector("[data-theme-toggle]");
			const typewriterText = document.querySelector("[data-typewriter-text]");
			const aboutParticlesCanvas = document.querySelector("[data-about-particles]");
			const designDialog = document.querySelector("#design-dialog");
			const designPreviewTitle = document.querySelector("#design-preview-title");
			const designPreviewLabel = document.querySelector("#design-preview-label");
			const designPreviewDescription = document.querySelector("#design-preview-description");
			const designPreviewImage = document.querySelector("#design-preview-image");
			const projectDialog = document.querySelector("#project-dialog");
			const projectPreviewTitle = document.querySelector("#project-preview-title");
			const projectPreviewType = document.querySelector("#project-preview-type");
			const projectPreviewDescription = document.querySelector("#project-preview-description");
			const projectPreviewTools = document.querySelector("#project-preview-tools");
			const experienceCarousel = document.querySelector("[data-experience-carousel]");
			const experienceCards = Array.from(document.querySelectorAll("[data-experience-card]"));
			const experiencePrevButton = document.querySelector("[data-experience-prev]");
			const experienceNextButton = document.querySelector("[data-experience-next]");
			const experienceDots = Array.from(document.querySelectorAll("[data-experience-dot]"));

			const setTheme = (theme) => {
				document.documentElement.dataset.theme = theme;
				themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
				try {
					localStorage.setItem("theme", theme);
				} catch {
					// Ignore storage errors and keep the visual theme for this session.
				}
			};

			themeToggle?.setAttribute(
				"aria-pressed",
				String(document.documentElement.dataset.theme === "dark"),
			);

			themeToggle?.addEventListener("click", () => {
				const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
				setTheme(nextTheme);
			});

			const siteHeader = document.querySelector(".site-header");
			let lastScrollY = window.scrollY;

			const updateMobileHeader = () => {
				if (!siteHeader) return;
				if (window.innerWidth > 820) {
					siteHeader.classList.remove("scrolling-down");
					lastScrollY = window.scrollY;
					return;
				}

				const currentScroll = window.scrollY;
				if (currentScroll <= 32) {
					siteHeader.classList.remove("scrolling-down");
				} else if (currentScroll > lastScrollY + 4) {
					siteHeader.classList.add("scrolling-down");
				} else if (currentScroll < lastScrollY - 4) {
					siteHeader.classList.remove("scrolling-down");
				}
				lastScrollY = currentScroll;
			};

			window.addEventListener("scroll", updateMobileHeader, { passive: true });
			window.addEventListener("resize", updateMobileHeader);
			updateMobileHeader();

			if (typewriterText instanceof HTMLElement) {
				const phrases = ['clarity', 'curiosity', 'intention'];
				let phraseIndex = 0;
				let letterIndex = 0;
				let deleting = false;
				let pauseTicks = 0;

				setInterval(() => {
					const currentPhrase = phrases[phraseIndex] ?? "";

					if (pauseTicks > 0) {
						pauseTicks -= 1;
						return;
					}

					if (!deleting) {
						letterIndex += 1;
						typewriterText.textContent = currentPhrase.slice(0, letterIndex);

						if (letterIndex >= currentPhrase.length) {
							deleting = true;
							pauseTicks = 12;
						}
						return;
					}

					letterIndex -= 1;
					typewriterText.textContent = currentPhrase.slice(0, letterIndex);

					if (letterIndex <= 0) {
						deleting = false;
						phraseIndex = (phraseIndex + 1) % phrases.length;
						pauseTicks = 4;
					}
				}, 90);
			}

			if (aboutParticlesCanvas instanceof HTMLCanvasElement) {
				const context = aboutParticlesCanvas.getContext("2d");
				const particleCount = 60;
				const particleRadius = 2;
				const linkDistance = 120;
				const particles = [];
				let canvasWidth = 0;
				let canvasHeight = 0;
				let dpr = 1;

				const parseColorToRgb = (value) => {
					if (value.startsWith("#")) {
						let hex = value.slice(1);
						if (hex.length === 3) hex = hex.split("").map((char) => char + char).join("");
						const parsed = Number.parseInt(hex, 16);
						if (Number.isNaN(parsed)) return { r: 125, g: 79, b: 54 };
						return {
							r: (parsed >> 16) & 255,
							g: (parsed >> 8) & 255,
							b: parsed & 255,
						};
					}

					const matches = value.match(/\d+(\.\d+)?/g);
					if (!matches || matches.length < 3) return { r: 125, g: 79, b: 54 };
					return {
						r: Number.parseFloat(matches[0] ?? "125"),
						g: Number.parseFloat(matches[1] ?? "79"),
						b: Number.parseFloat(matches[2] ?? "54"),
					};
				};

				const accentValue =
					getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || "#7d4f36";
				const accentRgb = parseColorToRgb(accentValue);

				const createParticle = () => ({
					x: Math.random() * Math.max(canvasWidth, 1),
					y: Math.random() * Math.max(canvasHeight, 1),
					vx: (Math.random() - 0.5) * 0.34,
					vy: (Math.random() - 0.5) * 0.34,
				});

				const resizeCanvas = () => {
					const bounds = aboutParticlesCanvas.getBoundingClientRect();
					canvasWidth = bounds.width;
					canvasHeight = bounds.height;
					dpr = window.devicePixelRatio || 1;

					aboutParticlesCanvas.width = Math.max(Math.floor(canvasWidth * dpr), 1);
					aboutParticlesCanvas.height = Math.max(Math.floor(canvasHeight * dpr), 1);

					if (context) context.setTransform(dpr, 0, 0, dpr, 0, 0);

					if (particles.length === 0) {
						for (let index = 0; index < particleCount; index += 1) {
							particles.push(createParticle());
						}
						return;
					}

					particles.forEach((particle) => {
						particle.x = Math.min(Math.max(particle.x, 0), Math.max(canvasWidth, 1));
						particle.y = Math.min(Math.max(particle.y, 0), Math.max(canvasHeight, 1));
					});
				};

				const animateParticles = () => {
					if (!context) return;

					context.clearRect(0, 0, canvasWidth, canvasHeight);

					for (let index = 0; index < particles.length; index += 1) {
						const particle = particles[index];
						if (!particle) continue;

						particle.x += particle.vx;
						particle.y += particle.vy;

						if (particle.x <= 0 || particle.x >= canvasWidth) particle.vx *= -1;
						if (particle.y <= 0 || particle.y >= canvasHeight) particle.vy *= -1;

						particle.x = Math.min(Math.max(particle.x, 0), canvasWidth);
						particle.y = Math.min(Math.max(particle.y, 0), canvasHeight);
					}

					context.strokeStyle = `rgba(${accentRgb.r}, ${accentRgb.g}, ${accentRgb.b}, 0.14)`;
					context.lineWidth = 1;

					for (let i = 0; i < particles.length; i += 1) {
						const first = particles[i];
						if (!first) continue;
						for (let j = i + 1; j < particles.length; j += 1) {
							const second = particles[j];
							if (!second) continue;

							const dx = first.x - second.x;
							const dy = first.y - second.y;
							const distance = Math.hypot(dx, dy);
							if (distance > linkDistance) continue;

							const opacity = (1 - distance / linkDistance) * 0.2;
							context.strokeStyle = `rgba(${accentRgb.r}, ${accentRgb.g}, ${accentRgb.b}, ${opacity})`;
							context.beginPath();
							context.moveTo(first.x, first.y);
							context.lineTo(second.x, second.y);
							context.stroke();
						}
					}

					context.fillStyle = `rgba(${accentRgb.r}, ${accentRgb.g}, ${accentRgb.b}, 0.32)`;
					particles.forEach((particle) => {
						context.beginPath();
						context.arc(particle.x, particle.y, particleRadius, 0, Math.PI * 2);
						context.fill();
					});

					requestAnimationFrame(animateParticles);
				};

				resizeCanvas();
				animateParticles();

				if ("ResizeObserver" in window) {
					const observer = new ResizeObserver(() => resizeCanvas());
					observer.observe(aboutParticlesCanvas);
				} else {
					window.addEventListener("resize", resizeCanvas);
				}
			}

			if (experienceCarousel && experienceCards.length > 0) {
				let activeIndex = experienceCards.findIndex((card) => card.classList.contains("is-active"));
				if (activeIndex < 0) activeIndex = 0;

				const setActiveExperience = (nextIndex, direction = "next") => {
					if (nextIndex === activeIndex) return;

					const previousCard = experienceCards[activeIndex];
					const nextCard = experienceCards[nextIndex];
					if (!(previousCard instanceof HTMLElement) || !(nextCard instanceof HTMLElement)) return;

					previousCard.classList.remove("is-active");
					previousCard.setAttribute("aria-hidden", "true");
					nextCard.classList.remove("enter-from-next", "enter-from-prev");
					nextCard.classList.add(direction === "prev" ? "enter-from-prev" : "enter-from-next");
					nextCard.setAttribute("aria-hidden", "false");

					requestAnimationFrame(() => {
						nextCard.classList.add("is-active");
						nextCard.classList.remove("enter-from-next", "enter-from-prev");
					});

					experienceDots.forEach((dot, index) => {
						const isCurrent = index === nextIndex;
						dot.classList.toggle("is-active", isCurrent);
						dot.setAttribute("aria-current", isCurrent ? "true" : "false");
					});

					activeIndex = nextIndex;
				};

				experiencePrevButton?.addEventListener("click", () => {
					const nextIndex =
						(activeIndex - 1 + experienceCards.length) % experienceCards.length;
					setActiveExperience(nextIndex, "prev");
				});

				experienceNextButton?.addEventListener("click", () => {
					const nextIndex = (activeIndex + 1) % experienceCards.length;
					setActiveExperience(nextIndex, "next");
				});

				experienceDots.forEach((dot, index) => {
					dot.addEventListener("click", () => {
						const direction = index < activeIndex ? "prev" : "next";
						setActiveExperience(index, direction);
					});
				});
			}

			document.querySelectorAll(".project-postcard").forEach((button) => {
				button.addEventListener("click", () => {
					if (!(projectDialog instanceof HTMLDialogElement)) return;

					const projectTitle = button.dataset.projectTitle ?? "Project details";
					const projectType = button.dataset.projectType ?? "Project";
					const projectDescription =
						button.dataset.projectDescription ?? "Project details are available on request.";
					const projectTools = button.dataset.projectTools ?? "Tools available on request";

					if (projectPreviewTitle) projectPreviewTitle.textContent = projectTitle;
					if (projectPreviewType) projectPreviewType.textContent = projectType;
					if (projectPreviewDescription) projectPreviewDescription.textContent = projectDescription;
					if (projectPreviewTools) projectPreviewTools.textContent = projectTools;

					projectDialog.showModal();
				});
			});

			document.querySelectorAll(".design-item").forEach((button) => {
				button.addEventListener("click", () => {
					if (!(designDialog instanceof HTMLDialogElement)) return;

					const designTitle = button.dataset.designTitle ?? "Design preview";
					const designLabel = button.dataset.designLabel ?? "Design";
					const designDescription =
						button.dataset.designDescription ?? "Selected design portfolio render.";
					const designSrc = button.dataset.designSrc ?? "";
					const designAlt = button.dataset.designAlt ?? designTitle;

					if (designPreviewTitle) designPreviewTitle.textContent = designTitle;
					if (designPreviewLabel) designPreviewLabel.textContent = designLabel;
					if (designPreviewDescription) designPreviewDescription.textContent = designDescription;
					if (designPreviewImage instanceof HTMLImageElement) {
						designPreviewImage.src = designSrc;
						designPreviewImage.alt = designAlt;
					}

					designDialog.showModal();
				});
			});

			document.querySelectorAll(".certification-item").forEach((button) => {
				button.addEventListener("click", () => {
					if (!(dialog instanceof HTMLDialogElement)) return;

					const certTitle = button.dataset.certTitle ?? "Certification";
					const credential = button.dataset.certCredential ?? "Credential";
					const issuer = button.dataset.certIssuer ?? "Issuer available on request";
					const certFocus = button.dataset.certFocus ?? "Credential details";
					const certDetail =
						button.dataset.certDetail ??
						"Additional certificate details can be shared by the site owner on request.";

					if (title) title.textContent = certTitle;
					if (meta) meta.textContent = issuer;
					if (mark) mark.textContent = credential;
					if (focus) focus.textContent = certFocus;
					if (detail) detail.textContent = certDetail;
					if (requestLink instanceof HTMLAnchorElement) {
						requestLink.href = "#contact";
						requestLink.dataset.requestedCertificate = certTitle;
						requestLink.setAttribute(
							"aria-label",
							`Request download permission for ${certTitle}`,
						);
					}

					dialog.showModal();
				});
			});

			closeButton?.addEventListener("click", () => {
				if (dialog instanceof HTMLDialogElement) dialog.close();
			});

			requestLink?.addEventListener("click", () => {
				if (dialog instanceof HTMLDialogElement) dialog.close();
			});
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
		--background: #f4f0e8;
		--surface: #fbf8f1;
		--text: #211d18;
		--muted: #6f6558;
		--line: #d8cfc0;
		--accent: #7d4f36;
		--accent-dark: #4a2f24;
		--inverse: #211d18;
		--inverse-text: #fbf8f1;
		--max-width: 1120px;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	:root[data-theme="dark"] {
		--background: #191512;
		--surface: #211c18;
		--text: #f4efe6;
		--muted: #b8ad9e;
		--line: #3c332b;
		--accent: #d6a984;
		--accent-dark: #f0d4bd;
		--inverse: #f4efe6;
		--inverse-text: #191512;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		background: var(--background);
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: var(--background);
		color: var(--accent-dark);
		font-size: 16px;
		line-height: 1.6;
		transition:
			background 180ms ease,
			color 180ms ease;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	main,
	.site-footer {
		width: min(calc(100% - 40px), var(--max-width));
		margin: 0 auto;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: 100%;
		margin: 0;
		padding: 22px max(20px, calc((100% - var(--max-width)) / 2));
		background: color-mix(in srgb, var(--background) 92%, transparent);
		backdrop-filter: blur(18px);
		border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.15rem;
		font-weight: 600;
	}

	.tesseract-mark {
		width: 30px;
		height: 30px;
		flex: 0 0 auto;
		color: var(--accent-dark);
		filter: drop-shadow(0 0 8px color-mix(in srgb, var(--accent) 38%, transparent));
		overflow: visible;
		animation: tesseract-spin 7s linear infinite;
	}

	.tesseract-mark path {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.tesseract-core {
		opacity: 0.72;
		animation: tesseract-counterspin 4.8s linear infinite;
		transform-origin: 20px 20px;
	}

	@keyframes tesseract-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes tesseract-counterspin {
		from {
			transform: rotate(360deg) scale(0.92);
		}
		to {
			transform: rotate(0deg) scale(0.92);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tesseract-mark,
		.tesseract-core {
			animation: none;
		}
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 6px;
		color: var(--muted);
		font-size: 0.94rem;
	}

	.nav-links a {
		padding: 8px 12px;
		border-radius: 999px;
		transition:
			background 180ms ease,
			color 180ms ease;
	}

	.nav-links a:hover,
	.nav-links a:focus-visible {
		background: var(--inverse);
		color: var(--inverse-text);
		outline: 0;
	}

	.site-footer a {
		transition:
			color 180ms ease,
			border-color 180ms ease;
	}

	.site-footer a:hover {
		color: var(--text);
	}

	.theme-toggle {
		position: relative;
		width: 54px;
		height: 30px;
		flex: 0 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		justify-items: center;
		padding: 3px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 999px;
		overflow: hidden;
		cursor: pointer;
	}

	.theme-icon {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 16px;
		height: 16px;
		color: var(--muted);
		opacity: 0.72;
		transition:
			color 180ms ease,
			opacity 180ms ease;
	}

	.theme-icon svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.theme-icon.moon svg {
		stroke-width: 1.9;
	}

	.theme-thumb {
		position: absolute;
		top: 3px;
		left: 3px;
		z-index: 0;
		width: 22px;
		height: 22px;
		background: var(--inverse);
		border-radius: 50%;
		box-shadow: 0 2px 8px color-mix(in srgb, var(--text) 30%, transparent);
		transition:
			background 180ms ease,
			transform 180ms ease;
	}

	.theme-toggle[aria-pressed="true"] .theme-thumb {
		transform: translateX(24px);
	}

	.theme-toggle[aria-pressed="false"] .theme-icon.sun,
	.theme-toggle[aria-pressed="true"] .theme-icon.moon {
		color: var(--inverse-text);
		opacity: 1;
	}

	.theme-toggle:hover,
	.theme-toggle:focus-visible {
		border-color: var(--accent);
		outline: 0;
	}

	.hero {
		min-height: 76vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 96px 0 72px;
		border-bottom: 1px solid var(--line);
	}

	.eyebrow {
		margin: 0 0 18px;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1,
	h2,
	h3 {
		font-family: Georgia, "Times New Roman", serif;
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: 0;
	}

	h1 {
		max-width: 980px;
		margin-bottom: 28px;
		font-size: clamp(3.2rem, 9vw, 7.4rem);
	}

	h2 {
		margin-bottom: 0;
		font-size: clamp(2rem, 5vw, 4.35rem);
	}

	h3 {
		margin-bottom: 0;
		font-size: clamp(1.55rem, 2.8vw, 2.25rem);
	}

	.hero-copy {
		max-width: 720px;
