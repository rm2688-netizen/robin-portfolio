					<a class="social-link" href={socialLinks.github} target="_blank" rel="noreferrer" aria-label="GitHub profile">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 2.75a9.25 9.25 0 0 0-2.92 18.03c.46.08.63-.2.63-.44v-1.6c-2.57.56-3.11-1.1-3.11-1.1-.42-1.07-1.03-1.35-1.03-1.35-.84-.57.06-.56.06-.56.93.07 1.42.96 1.42.96.82 1.4 2.15 1 2.68.77.08-.6.32-1 .58-1.23-2.05-.23-4.21-1.03-4.21-4.57 0-1.01.36-1.84.95-2.48-.1-.24-.41-1.18.09-2.45 0 0 .78-.25 2.54.95A8.75 8.75 0 0 1 12 5.37c.78 0 1.57.1 2.31.31 1.76-1.2 2.53-.95 2.53-.95.51 1.27.19 2.21.09 2.45.6.64.95 1.47.95 2.48 0 3.55-2.16 4.34-4.22 4.57.33.29.63.85.63 1.72v2.55c0 .24.17.52.64.43A9.25 9.25 0 0 0 12 2.75Z"></path>
