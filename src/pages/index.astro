---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="A minimal personal portfolio template featuring selected work, skills, resume, and contact information."
		/>
		<title>Minimal Portfolio</title>
		<script is:inline>
			try {
				const savedTheme = localStorage.getItem("theme");
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? "dark" : "light");
			} catch {
				document.documentElement.dataset.theme = "light";
			}
		</script>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="#top" aria-label="Portfolio home">
				<span>Robin Miranda</span>
				<svg class="tesseract-mark" viewBox="0 0 40 40" aria-hidden="true">
					<g class="tesseract-shell">
						<path d="M8 11h18v18H8z"></path>
						<path d="M14 5h18v18H14z"></path>
						<path d="M8 11 14 5M26 11l6-6M26 29l6-6M8 29l6-6"></path>
					</g>
					<g class="tesseract-core">
						<path d="M14 16h12v12H14z"></path>
						<path d="M18 12h12v12H18z"></path>
						<path d="M14 16l4-4M26 16l4-4M26 28l4-4M14 28l4-4"></path>
					</g>
				</svg>
			</a>
			<nav class="nav-links" aria-label="Main navigation">
				<a href="#about">About</a>
				<a href="#experience">Experience</a>
				<a href="#projects">Projects</a>
				<a href="#skills">Skills</a>
				<a href="#design">Design</a>
				<a href="#certifications">Certifications</a>
				<a href="#resume">Resume</a>
				<a href="#contact">Contact</a>
			</nav>
			<button class="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" data-theme-toggle>
				<span class="theme-icon sun" aria-hidden="true">
					<svg viewBox="0 0 24 24">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2.5v2.5M12 19v2.5M21.5 12H19M5 12H2.5M18.72 5.28l-1.77 1.77M7.05 16.95l-1.77 1.77M18.72 18.72l-1.77-1.77M7.05 7.05 5.28 5.28"></path>
					</svg>
				</span>
				<span class="theme-icon moon" aria-hidden="true">
					<svg viewBox="0 0 24 24">
						<path d="M20.2 14.15A8.5 8.5 0 1 1 9.85 3.8a7 7 0 1 0 10.35 10.35Z"></path>
					</svg>
				</span>
				<span class="theme-thumb" aria-hidden="true"></span>
			</button>
		</header>

		<main id="top">
			<section class="hero" aria-labelledby="hero-title">
				<p class="eyebrow">Personal Portfolio</p>
				<h1 id="hero-title">
					Engineering with <span class="hero-typewriter"><span data-typewriter-text>"clarity"</span><span class="typewriter-cursor" aria-hidden="true">|</span></span>
				</h1>
				<p class="hero-copy">
					I design complex mechanical systems, solve real-world problems, and build experiences that balance functionality with simplicity.
				</p>
				<div class="hero-actions" aria-label="Primary actions">
					<a class="button primary" href="#experience">View experience</a>
					<a class="button secondary" href="#contact">Get in touch</a>
				</div>
			</section>

			<section class="section intro-grid about-layout" id="about" aria-labelledby="about-title">
				<div class="about-portrait-column">
					<figure class="about-portrait">
						<img src={profileImage} alt="Portrait of Robin Miranda" loading="lazy" />
						<figcaption>
							<span class="about-greeting">Hi there!</span>
							<span>It's me, Robin.</span>
						</figcaption>
					</figure>
				</div>
				<div class="section-copy about-copy">
					<canvas class="about-particles" data-about-particles aria-hidden="true"></canvas>
					<div class="about-copy-content">
						<p class="eyebrow">About</p>
						<h2 id="about-title">Mechanical engineer focused on thoughtful designs.</h2>
						<p>
							I work at the intersection of mechanical design, manufacturing, and analysis,
							turning technical requirements into clear, buildable solutions. My background
							includes CAD, GD&T, tolerance stack-up analysis, FEA, root cause analysis, lean
							manufacturing, and continuous improvement.
						</p>
						<p>
							I'm drawn to engineering work where precision and practicality have to meet:
							designs that are clean on screen, sensible to manufacture, and easy for teams to
							understand. Curiosity for science and technology keeps me moving, but useful,
							well-communicated outcomes are what keep the work grounded.
						</p>
					</div>
				</div>
			</section>

			<section class="section experience-section" id="experience" aria-labelledby="experience-title">
				<div class="section-heading">
					<p class="eyebrow">Experience</p>
					<h2 id="experience-title">Work experience across design, quality, and manufacturing.</h2>
				</div>

				<div class="experience-list" data-experience-carousel>
					{
						experience.map((role, index) => (
							<article
								class={`experience-card experience-card-panel ${index === 0 ? "is-active" : ""}`}
								data-experience-card
								data-index={index}
								aria-hidden={index === 0 ? "false" : "true"}
							>
								<div class="experience-meta">
									<span>{role.period}</span>
									<span>{role.location}</span>
								</div>
								<div>
									<h3>{role.title}</h3>
									<p class="experience-company">{role.company}</p>
									<ul>
										{role.highlights.map((highlight) => <li>{highlight}</li>)}
									</ul>
								</div>
							</article>
						))
					}
				</div>
				<div class="experience-controls" aria-label="Experience navigation">
					<button class="experience-nav-button" type="button" data-experience-prev aria-label="Previous role">
						<span aria-hidden="true">←</span>
					</button>
					<div class="experience-dots" aria-label="Jump to role">
						{
							experience.map((role, index) => (
								<button
									class={`experience-dot ${index === 0 ? "is-active" : ""}`}
									type="button"
									data-experience-dot
									data-index={index}
									aria-label={`Go to role ${index + 1}: ${role.title}`}
									aria-current={index === 0 ? "true" : "false"}
								></button>
							))
						}
					</div>
					<button class="experience-nav-button" type="button" data-experience-next aria-label="Next role">
						<span aria-hidden="true">→</span>
					</button>
				</div>
			</section>

			<section class="section projects-section" id="projects" aria-labelledby="projects-title">
				<div class="section-heading">
					<p class="eyebrow">Projects</p>
					<h2 id="projects-title">Engineering projects with practical design and analysis at the center.</h2>
				</div>

				<div class="project-postcard-grid">
					{
						projects.map((project) => (
							<button
								type="button"
								class="project-postcard"
								data-project-title={project.title}
								data-project-type={project.type}
								data-project-description={project.description}
								data-project-tools={project.tools}
								aria-haspopup="dialog"
							>
								<span>{project.title}</span>
							</button>
						))
					}
				</div>
			</section>

			<dialog class="project-dialog" id="project-dialog" aria-labelledby="project-preview-title">
				<form method="dialog">
					<button class="dialog-close" type="submit" aria-label="Close project details">Close</button>
				</form>
				<p class="eyebrow" id="project-preview-type">Project</p>
				<h3 id="project-preview-title">Project title</h3>
				<p id="project-preview-description">Project details will appear here.</p>
				<p class="project-preview-tools" id="project-preview-tools">Tools</p>
			</dialog>

			<section class="section skills-section" id="skills" aria-labelledby="skills-title">
				<div class="section-heading">
					<p class="eyebrow">Skills</p>
					<h2 id="skills-title">Capabilities that support clean, useful work.</h2>
				</div>
				<ul class="skills-list" aria-label="Skills and tools">
					{
						skills.map((skill) => (
							<li>
								<span class="skill-mark" aria-hidden="true">{skill.mark}</span>
								<span class="skill-name">{skill.name}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section design-section" id="design" aria-labelledby="design-title">
				<div class="section-heading design-heading">
					<p class="eyebrow">Design</p>
					<h2 id="design-title">A focused selection of CAD renderings.</h2>
					<!-- <p class="design-intro">
						This section draws from the design portfolio notes and showcases a tighter set of
						mechanical renders chosen for clarity, finish, and professional presentation.
					</p>end comment -->
				</div>

				<div class="design-grid">
					{
						designPortfolio.map((item) => (
							<button
								type="button"
								class="design-item"
								data-design-title={item.title}
								data-design-label={item.label}
								data-design-description={item.description}
								data-design-src={item.src}
								data-design-alt={item.alt}
								aria-haspopup="dialog"
							>
								<span class="design-label">{item.label}</span>
								<strong>{item.title}</strong>
								<span class="design-description">{item.description}</span>
								<span class="design-action">View render</span>
							</button>
						))
					}
				</div>
			</section>

			<dialog class="design-dialog" id="design-dialog" aria-labelledby="design-preview-title">
				<form method="dialog">
					<button class="dialog-close" type="submit" aria-label="Close design preview">Close</button>
				</form>
				<div class="design-preview-copy">
					<p class="eyebrow" id="design-preview-label">Design Preview</p>
					<h3 id="design-preview-title">Design title</h3>
					<p id="design-preview-description">Design details will appear here.</p>
				</div>
				<div class="design-preview-frame">
					<img id="design-preview-image" alt="" />
				</div>
			</dialog>

			<section class="section certifications-section" id="certifications" aria-labelledby="certifications-title">
				<div class="section-heading">
					<p class="eyebrow">Certifications</p>
					<h2 id="certifications-title">Credentials with practical engineering weight.</h2>
				</div>
				<article class="certifications-card">
					<div class="certification-list" aria-label="Certifications">
						{
							certifications.map((certification, index) => (
								<button
									type="button"
									class="certification-item"
									data-cert-title={certification.title}
									data-cert-credential={certification.credential}
									data-cert-issuer={certification.issuer}
									data-cert-focus={certification.focus}
									data-cert-detail={certification.detail}
									aria-haspopup="dialog"
								>
									<span class="certification-index">{String(index + 1).padStart(2, "0")}</span>
									<span class="certification-content">
										<em>{certification.credential}</em>
										<strong>{certification.title}</strong>
										<small>{certification.focus}</small>
									</span>
								</button>
							))
						}
					</div>
				</article>
			</section>

			<dialog class="credential-dialog" id="credential-dialog" aria-labelledby="credential-title">
				<form method="dialog">
					<button class="dialog-close" type="submit" aria-label="Close certification preview">Close</button>
				</form>
				<p class="eyebrow" id="credential-label">Certification Preview</p>
				<h3 id="credential-title">Credential title</h3>
				<p class="credential-meta" id="credential-meta">Issuer</p>
				<div class="credential-preview" aria-label="Credential details">
					<span id="credential-mark">EIT</span>
					<p id="credential-focus">Credential focus</p>
				</div>
				<p id="credential-detail">
					Credential details will appear here when a certification is selected.
				</p>
				<div class="dialog-actions">
					<a class="button primary" href="#contact" data-request-permission>
						Request download permission
					</a>
					<button class="button secondary" type="button" data-close-dialog>Close preview</button>
				</div>
			</dialog>

			<section class="section resume-section" id="resume" aria-labelledby="resume-title">
				<div class="section-heading">
					<p class="eyebrow">Resume</p>
					<h2 id="resume-title">A PDF version of my engineering background.</h2>
				</div>
				<article class="resume-card">
					<p>
						Download the resume for a detailed view of my experience, education, certifications,
						and technical background.
					</p>
					<a class="button secondary" href={resumeHref} download>
						Download resume
					</a>
				</article>
			</section>

			<section class="section contact-section" id="contact" aria-labelledby="contact-title">
				<p class="eyebrow">Contact</p>
				<h2 id="contact-title">Let's make the next useful thing feel clear.</h2>
				<p>
					Feel free to reach out if you have any questions or would like to connect!
				</p>
				<div class="contact-actions" aria-label="Contact links">
					<a class="social-link email-link" href="mailto:rm2688@rit.edu" aria-label="Email Robin Miranda">
						<svg viewBox="0 0 24 24" aria-hidden="true">
